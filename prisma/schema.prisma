datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password
  nombre    String?
  rol       String   @default("SECRETARIO") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ciudadano {
  id        String     @id @default(cuid())
  cedula    String     @unique
  nombres   String
  vereda    String
  telefono  String?
  peticiones Peticion[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Peticion {
  id          String    @id @default(cuid())
  asunto      String
  descripcion String?
  estado      String    @default("PENDIENTE") // PENDIENTE, EN_GESTION, CUMPLIDO
  ciudadanoId String
  ciudadano   Ciudadano @relation(fields: [ciudadanoId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Reunion {
  id           String   @id @default(cuid())
  titulo       String
  fecha        DateTime
  notas        String?  // Notas manuscritas / OCR
  acta         String?  // Acta formal generada por IA
  compromisos  String?  // Lista de compromisos detectados
  tareas       Tarea[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tarea {
  id          String   @id @default(cuid())
  descripcion String
  completado  Boolean  @default(false)
  reunionId   String
  reunion     Reunion  @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contacto {
  id        String   @id @default(cuid())
  nombre    String
  cedula    String?  @unique
  celular   String?
  direccion String?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaccion {
  id            String   @id @default(cuid())
  concepto      String
  monto         Float
  tipo          String   // "INGRESO" o "EGRESO"
  categoria     String?  // Ej: "Papelería", "Eventos", "Viáticos"
  fecha         DateTime @default(now())
  montoAbonado  Float    @default(0) // Para EGRESOS que son deudas: cuánto se ha pagado hasta ahora
  proyectoId    String?
  proyecto      Proyecto? @relation(fields: [proyectoId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Proyecto {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  presupuesto Float    @default(0)
  estado      String   @default("ACTIVO")
  transacciones Transaccion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// PRESUPUESTO 2026 – Consolidado general de gastos (cierre de vigencia)
// Una sola hoja editable guardada como documento JSON. Valores en pesos enteros.
// ─────────────────────────────────────────────────────────────────────────────
model PresupuestoCierre {
  id            String   @id @default("cierre-2026")
  datos         Json
  version       Int      @default(1)
  modificadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// OBSOLETO: tablas del primer "Simulador Presupuestal" (reemplazado por
// PresupuestoCierre). Ya no se usan en el código; se conservan para no borrar
// datos de producción sin autorización. Se pueden eliminar con una migración.
// ─────────────────────────────────────────────────────────────────────────────

// Configuración general del módulo (fila única id = "default").
model SimConfig {
  id               String   @id @default("default")
  victimasRecursos Int      @default(0) // Recursos de Víctimas (destinación específica)
  victimasMesa     Int      @default(0) // Actividades Mesa Municipal de Víctimas
  victimasNotas    String?
  modificadoPor    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Catálogo de conceptos de gasto (compartido por todos los escenarios).
model SimGasto {
  id              String             @id @default(cuid())
  nombre          String
  categoria       String // DEPORTES, CULTURA, REGALOS_NAVIDAD, GOBIERNO_SOCIAL, ...
  grupo           String             @default("PENDIENTE") // PENDIENTE, POR_CONFIRMAR, CUBIERTO_CDP, OTRA_VIGENCIA, RETIRADO
  valorReferencia Int? // Valor presupuestado de referencia (null = por definir)
  descripcion     String?
  observaciones   String?
  prioridad       String             @default("MEDIA") // ALTA, MEDIA, BAJA
  orden           Int                @default(0)
  creadoPor       String?
  modificadoPor   String?
  items           SimEscenarioItem[]
  desglose        SimDesglose[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// Desglose interno opcional de una actividad.
model SimDesglose {
  id       String   @id @default(cuid())
  gastoId  String
  gasto    SimGasto @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  concepto String
  valor    Int?
  orden    Int      @default(0)
}

// Escenario presupuestal guardado. Cada escenario tiene su propia
// disponibilidad y sus propias decisiones por gasto.
model SimEscenario {
  id            String             @id @default(cuid())
  nombre        String
  descripcion   String?
  observaciones String?
  bolsaInicial  Int
  descuento     Int
  bloqueado     Boolean            @default(false) // Escenario de referencia protegido contra cambios
  orden         Int                @default(0)
  creadoPor     String?
  modificadoPor String?
  items         SimEscenarioItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// Decisión sobre un gasto dentro de un escenario.
model SimEscenarioItem {
  id            String       @id @default(cuid())
  escenarioId   String
  escenario     SimEscenario @relation(fields: [escenarioId], references: [id], onDelete: Cascade)
  gastoId       String
  gasto         SimGasto     @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  incluido      Boolean      @default(true)
  valor         Int?
  estado        String       @default("PENDIENTE") // PENDIENTE, APROBADO, DESCARTADO, REDUCIDO
  observaciones String?
  updatedAt     DateTime     @updatedAt

  @@unique([escenarioId, gastoId])
  @@index([gastoId])
}
